+		Auth:     stubAuth{rc: RequestContext{RuntimeMode: "cache"}}, Creds: stubCreds{key: "sk-test"},
+		HTTPClient: &http.Client{Transport: roundTripFunc(func(r *http.Request) (*http.Response, error) {
+			upstreamCalls++
+			forwarded, _ = io.ReadAll(r.Body)
+			return &http.Response{StatusCode: 200, Header: make(http.Header), Body: io.NopCloser(strings.NewReader(`{}`))}, nil
+		})},
+	})
+	for _, tc := range []struct {
+		size, status int
+		bypass       bool
+	}{
+		{128, 200, false}, {129, 200, true}, {128, 200, false}, {200, 200, true}, {201, 413, false},
+	} {
+		body := `{"model":"gpt-5.6","input":"original"}`
+		body += strings.Repeat(" ", tc.size-len(body))
+		rec := httptest.NewRecorder()
+		req := httptest.NewRequest(http.MethodPost, "/v1/responses", strings.NewReader(body))
+		req.ContentLength = -1 // Enforce limits using bytes read, including chunked uploads.
+		srv.Handler().ServeHTTP(rec, req)
+		if rec.Code != tc.status || (rec.Header().Get("x-cave-bypass") == "request_size") != tc.bypass {
+			t.Fatalf("size=%d: status=%d bypass=%q", tc.size, rec.Code, rec.Header().Get("x-cave-bypass"))
+		}
+		if tc.bypass && string(forwarded) != body {
+			t.Fatalf("size=%d: bypass changed payload", tc.size)
+		}
+	}
+	if upstreamCalls != 4 || nativeCalls != 2 {
+		t.Fatalf("upstream=%d native=%d: hard rejection must not forward, and next small request must optimize", upstreamCalls, nativeCalls)
+	}
+}
+
+func TestRequestSizeBypassPreservesUpstreamResponseWithoutReplay(t *testing.T) {
+	t.Setenv("CAVE_MAX_TRANSFORM_BYTES", "1")
+	for _, tc := range []struct {
+		status                int
+		contentType, response string
+	}{
+		{200, "text/event-stream", "data: {\"type\":\"response.completed\"}\n\n"},
+		{413, "application/json", `{"error":"upstream limit"}`},
+	} {
+		calls := 0
+		srv := New(Config{
+			Adapters: []providers.Adapter{openai.New("https://upstream.test")},
+			Auth:     stubAuth{rc: RequestContext{RuntimeMode: "compress"}}, Creds: stubCreds{},
+			HTTPClient: &http.Client{Transport: roundTripFunc(func(r *http.Request) (*http.Response, error) {
+				calls++
+				return &http.Response{StatusCode: tc.status, Header: http.Header{"Content-Type": {tc.contentType}}, Body: io.NopCloser(strings.NewReader(tc.response))}, nil
+			})},
+		})
+		rec := httptest.NewRecorder()
+		srv.Handler().ServeHTTP(rec, httptest.NewRequest(http.MethodPost, "/v1/responses", strings.NewReader(`{"model":"gpt-5.6","input":"hello"}`)))
+		if calls != 1 || rec.Code != tc.status || rec.Body.String() != tc.response {
+			t.Fatalf("upstream response changed/replayed: calls=%d status=%d body=%q", calls, rec.Code, rec.Body.String())
+		}
+	}
+}
+
+func TestRequestSizeInvalidLimitsKeepFiniteDefaults(t *testing.T) {
+	for _, value := range []string{"", "0", "-1", "invalid", "9223372036854775807"} {
+		t.Run(value, func(t *testing.T) {
+			t.Setenv("CAVE_MAX_REQUEST_BYTES", value)
+			t.Setenv("CAVE_MAX_TRANSFORM_BYTES", value)
+			const body = `{"model":"gpt-5.6","input":"hello"}`
+			srv := New(Config{
+				Adapters: []providers.Adapter{openai.New("https://upstream.test")},
+				Auth:     stubAuth{rc: RequestContext{RuntimeMode: "record"}}, Creds: stubCreds{},
+				HTTPClient: &http.Client{Transport: roundTripFunc(func(r *http.Request) (*http.Response, error) {
+					got, _ := io.ReadAll(r.Body)
+					if string(got) != body {
+						t.Errorf("invalid limit truncated request: %q", got)
+					}
+					return &http.Response{StatusCode: 200, Header: make(http.Header), Body: io.NopCloser(strings.NewReader(`{}`))}, nil
+				})},
+			})
+			rec := httptest.NewRecorder()
+			srv.Handler().ServeHTTP(rec, httptest.NewRequest(http.MethodPost, "/v1/responses", strings.NewReader(body)))
+			if rec.Code != 200 || rec.Header().Get("x-cave-bypass") != "" {
+				t.Fatalf("invalid limit rejected/bypassed small request: status=%d", rec.Code)
+			}
+		})
+	}
+}
