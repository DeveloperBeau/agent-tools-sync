diff --git a/proxy/internal/gateway/headroom_stream.go b/proxy/internal/gateway/headroom_stream.go
new file mode 100644
index 0000000..acca680
--- /dev/null
+++ b/proxy/internal/gateway/headroom_stream.go
@@ -0,0 +1,187 @@
+package gateway
+
+import (
+	"crypto/sha256"
+	"encoding/hex"
+	"errors"
+	"fmt"
+	"hash"
+	"io"
+	"net/http"
+	"sync"
+	"time"
+
+	"github.com/JuliusBrussee/caveman/proxy/providers"
+	"github.com/JuliusBrussee/caveman/shared/platform/httpx"
+)
+
+// headroomUpload counts only bytes consumed by the upstream transport. It never
+// retains content. A transport may still be finishing a request-body read when
+// an early response arrives, so snapshots synchronize with that reader.
+type headroomUpload struct {
+	reader io.Reader
+	closer io.Closer
+	mu     sync.Mutex
+	hash   hash.Hash
+	total  int
+	eof    bool
+	err    error
+}
+
+func (u *headroomUpload) Read(p []byte) (int, error) {
+	n, err := u.reader.Read(p)
+	u.mu.Lock()
+	u.total += n
+	_, _ = u.hash.Write(p[:n])
+	if err == io.EOF {
+		u.eof = true
+	} else if err != nil {
+		u.err = err
+	}
+	u.mu.Unlock()
+	return n, err
+}
+
+func (u *headroomUpload) Close() error { return u.closer.Close() }
+
+func (u *headroomUpload) snapshot(length int64) (count int, digest string, complete, limitHit bool) {
+	u.mu.Lock()
+	defer u.mu.Unlock()
+	complete = u.err == nil && ((length < 0 && u.eof) || (length >= 0 && int64(u.total) == length))
+	if complete {
+		digest = hex.EncodeToString(u.hash.Sum(nil))
+	}
+	var limitErr *http.MaxBytesError
+	return u.total, digest, complete, errors.As(u.err, &limitErr)
+}
+
+func (s *Server) rejectHeadroomUpload(w http.ResponseWriter, r *http.Request, requestID string, seen, limit int64) {
+	if s.logger != nil {
+		s.logger.Warn("request exceeds explicit upload limit", "event", "request_rejected",
+			"reason", "request_size", "request_id", requestID, "request_bytes_seen", seen, "request_limit_bytes", limit)
+	}
+	httpx.Error(w, r, http.StatusRequestEntityTooLarge, "cave_request_too_large", "Request body exceeds the configured proxy limit.")
+}
+
+// streamHeadroomUpload preserves the configured adapter/credential/SSRF path,
+// but neither inspects nor rewrites the body. Unlike buffered requests it can
+// never replay, including on a connection error or a provider rejection.
+func (s *Server) streamHeadroomUpload(w http.ResponseWriter, r *http.Request, rc RequestContext, adapter providers.Adapter, credential providers.Credential, authMode AuthMode, source io.Reader, start time.Time, requestID, traceID string, transformLimit, requestLimit int64) {
+	defer r.Body.Close()
+	// Streamed media can be backpressured while Headroom uploads upstream. The
+	// server's 30-second buffered-body deadline must not truncate that transfer.
+	// Keep a finite upload bound without changing other routes or header limits.
+	if err := http.NewResponseController(w).SetReadDeadline(time.Now().Add(15 * time.Minute)); err != nil && !errors.Is(err, http.ErrNotSupported) {
+		httpx.Error(w, r, http.StatusInternalServerError, "cave_request_read_failed", "Request upload deadline could not be set.")
+		return
+	}
+	w.Header().Set("x-cave-bypass", "request_size")
+	if s.logger != nil {
+		s.logger.Info("large upload streams through Headroom without optimization", "event", "request_bypass",
+			"reason", "request_size", "request_id", requestID, "content_length", r.ContentLength,
+			"transform_limit_bytes", transformLimit, "request_limit_bytes", requestLimit)
+	}
+	upstream, err := adapter.ResolveUpstreamURL(r.Context(), r, providers.RouteContext{})
+	if err != nil {
+		httpx.Error(w, r, http.StatusBadGateway, "cave_upstream_unavailable", "Upstream route could not be resolved.")
+		return
+	}
+	headers, err := adapter.SanitizeAndMapHeaders(r.Context(), r, credential, upstream)
+	if err != nil {
+		providerHeaderError(w, r, err)
+		return
+	}
+	if authMode != AuthModePAYG && r.UserAgent() != "" {
+		headers.Set("user-agent", r.UserAgent())
+	}
+	s.applyUpstreamAuthFallback(adapter.Name(), credential, headers)
+	// This is a proxy-owned decision, added only after caller header sanitation.
+	headers.Set("x-headroom-bypass", "true")
+	upload := &headroomUpload{reader: source, closer: r.Body, hash: sha256.New()}
+	upReq, err := http.NewRequestWithContext(r.Context(), r.Method, upstream.String(), upload)
+	if err != nil {
+		httpx.Error(w, r, http.StatusBadRequest, "cave_provider_request_invalid", "Upstream request could not be built.")
+		return
+	}
+	upReq.Header, upReq.ContentLength = headers, r.ContentLength
+	s.inflight.Add(1)
+	resp, err := s.httpClient.Do(upReq)
+	s.inflight.Add(-1)
+	if err != nil {
+		_ = upload.Close()
+		count, _, _, limitHit := upload.snapshot(r.ContentLength)
+		status, code := http.StatusBadGateway, "cave_upstream_unavailable"
+		if limitHit {
+			status, code = http.StatusRequestEntityTooLarge, "cave_request_too_large"
+			s.rejectHeadroomUpload(w, r, requestID, int64(count), requestLimit)
+		} else {
+			httpx.Error(w, r, status, code, "Upstream provider unavailable.")
+		}
+		s.recordHeadroomUpload(r, rc, adapter, authMode, upload, start, requestID, traceID, status, 0, 0, code, providers.UsageObservation{}, false)
+		return
+	}
+	defer resp.Body.Close()
+	copySafeResponseHeaders(w.Header(), resp.Header)
+	w.Header().Set("x-cave-project", rc.Label)
+	w.Header().Set("x-cave-mode", rc.RuntimeMode)
+	w.Header().Set("x-cave-optimization", "none")
+	w.WriteHeader(resp.StatusCode)
+	stream := streamingResponse(resp.Header)
+	usageScanner := adapter.NewUsageScanner(resp.Header)
+	counter, copyError := s.streamResponse(w, r, io.TeeReader(resp.Body, usageScanner), stream, requestID)
+	ttfb := time.Since(start).Milliseconds()
+	if !counter.firstByteAt.IsZero() {
+		ttfb = counter.firstByteAt.Sub(start).Milliseconds()
+	}
+	code := ""
+	if resp.StatusCode >= 400 {
+		code = fmt.Sprintf("provider_%d", resp.StatusCode)
+	}
+	usage := usageScanner.Usage()
+	if usage.ProviderError && code == "" {
+		code = "provider_error"
+		if stream {
+			code = "provider_stream_error"
+		}
+	}
+	if copyError != "" {
+		code = copyError
+	}
+	s.recordHeadroomUpload(r, rc, adapter, authMode, upload, start, requestID, traceID, resp.StatusCode, counter.n, ttfb, code, usage, stream)
+	if copyError != "" {
+		panic(http.ErrAbortHandler)
+	}
+}
+
+func (s *Server) recordHeadroomUpload(r *http.Request, rc RequestContext, adapter providers.Adapter, authMode AuthMode, upload *headroomUpload, start time.Time, requestID, traceID string, status int, responseBytes, ttfb int64, errorCode string, usage providers.UsageObservation, stream bool) {
+	count, digest, complete, _ := upload.snapshot(r.ContentLength)
+	if s.logger != nil {
+		s.logger.Info("streamed Headroom upload finished", "event", "request_bypass_complete", "reason", "request_size",
+			"request_id", requestID, "request_bytes", count, "request_hash_complete", complete,
+			"status", status, "error_code", errorCode, "latency_ms", time.Since(start).Milliseconds())
+	}
+	if complete {
+		body := streamedBody(count, digest)
+		s.capture.record(captureMeta{RequestID: requestID, Provider: adapter.Name(), Endpoint: r.URL.Path, RuntimeMode: "record"}, body, body)
+	}
+	if s.sink == nil {
+		return
+	}
+	evidence := requestEvidenceFromHeaders(r.Header)
+	row := RequestRecord{
+		Timestamp: start.UTC().Format("2006-01-02 15:04:05.000"), RequestID: requestID, TraceID: traceID,
+		Label: labelOrDefault(rc.Label, "local"), AgentSlug: rc.AgentSlug, SessionID: evidence.SessionID,
+		Provider: adapter.Name(), Model: "unknown", Endpoint: r.URL.Path, RouteFrom: r.URL.Path,
+		Stream: stream, StatusCode: status, ErrorCode: errorCode, LatencyMS: time.Since(start).Milliseconds(), TTFBMS: ttfb,
+		RequestBytes: count, ResponseBytes: responseBytes, RawRequestSHA256: digest, TransformedRequestSHA256: digest, RequestHashComplete: complete,
+		AuthMode: string(authMode), RuntimeMode: rc.RuntimeMode, Basis: "inferred", TokenUsageBasis: standaloneUsageBasis(usage),
+		InputTokens: usage.InputTokens, OutputTokens: usage.OutputTokens, CachedInputTokens: usage.CachedInputTokens,
+		CacheCreationInputTokens: usage.CacheCreationInputTokens, CacheCreation1hTokens: usage.CacheCreation1hTokens, ReasoningTokens: usage.ReasoningTokens,
+		CacheStatus: usage.CacheStatus,
+	}
+	// There is no parsed model/body to price. Provider usage remains observable,
+	// but request comparisons and savings must not invent a priced baseline.
+	meta := providers.RequestMetadata{Provider: adapter.Name(), Model: "unknown", PricingUnsupportedReason: "request_body_streamed"}
+	requestAccounting(&row, meta, usage, nil, nil, false)
+	s.sink.Record(row)
+}
diff --git a/proxy/internal/gateway/headroom_stream_test.go b/proxy/internal/gateway/headroom_stream_test.go
