index 0000000..0fbe0d3
--- /dev/null
+++ b/proxy/internal/gateway/headroom_stream_test.go
@@ -0,0 +1,472 @@
+package gateway
+
+import (
+	"bufio"
+	"bytes"
+	"context"
+	"crypto/sha256"
+	"encoding/hex"
+	"errors"
+	"io"
+	"net"
+	"net/http"
+	"net/http/httptest"
+	"strconv"
+	"strings"
+	"sync"
+	"testing"
+	"testing/iotest"
+	"time"
+
+	"github.com/JuliusBrussee/caveman/proxy/providers"
+	"github.com/JuliusBrussee/caveman/proxy/providers/openaicompat"
+)
+
+type headroomPipeListener struct {
+	next   chan net.Conn
+	closed chan struct{}
+	once   sync.Once
+	addr   net.Addr
+}
+
+func (l *headroomPipeListener) Accept() (net.Conn, error) {
+	select {
+	case conn := <-l.next:
+		return conn, nil
+	case <-l.closed:
+		return nil, net.ErrClosed
+	}
+}
+
+func (l *headroomPipeListener) Close() error {
+	l.once.Do(func() { close(l.closed) })
+	return nil
+}
+
+func (l *headroomPipeListener) Addr() net.Addr { return l.addr }
+
+type delayedHeadroomBody struct {
+	reader io.Reader
+	delay  time.Duration
+}
+
+func (r *delayedHeadroomBody) Read(p []byte) (int, error) {
+	if r.delay > 0 {
+		time.Sleep(r.delay)
+		r.delay = 0
+	}
+	return r.reader.Read(p)
+}
+
+func TestHeadroomStreamUploadOutlivesDefaultReadDeadline(t *testing.T) {
+	t.Setenv("CAVE_MAX_TRANSFORM_BYTES", "32")
+	t.Setenv("CAVE_MAX_REQUEST_BYTES", "")
+	for _, known := range []bool{true, false} {
+		t.Run("known="+strconv.FormatBool(known), func(t *testing.T) {
+			body := bytes.Repeat([]byte("m"), 200)
+			upstreamBody := make(chan []byte, 1)
+			gateway := headroomStreamServer(t, "record", nil, roundTripFunc(func(r *http.Request) (*http.Response, error) {
+				got, err := io.ReadAll(r.Body)
+				if err != nil {
+					return nil, err
+				}
+				upstreamBody <- got
+				return &http.Response{StatusCode: 200, Header: make(http.Header), Body: io.NopCloser(strings.NewReader("ok"))}, nil
+			}))
+			serverConn, clientConn := net.Pipe()
+			listener := &headroomPipeListener{next: make(chan net.Conn, 1), closed: make(chan struct{}), addr: serverConn.LocalAddr()}
+			listener.next <- serverConn
+			server := &http.Server{Handler: gateway.Handler(), ReadTimeout: 40 * time.Millisecond}
+			t.Cleanup(func() { server.Close() })
+			t.Cleanup(func() { clientConn.Close() })
+			go server.Serve(listener)
+			clientConn.SetDeadline(time.Now().Add(3 * time.Second))
+			// Send the detection prefix promptly, then model upload backpressure.
+			reader := io.MultiReader(bytes.NewReader(body[:40]), &delayedHeadroomBody{reader: bytes.NewReader(body[40:]), delay: 120 * time.Millisecond})
+			req, err := http.NewRequest(http.MethodPost, "http://caveman.test/compat/headroom/responses", reader)
+			if err != nil {
+				t.Fatal(err)
+			}
+			if known {
+				req.ContentLength = int64(len(body))
+			} else {
+				req.ContentLength = -1
+			}
+			written := make(chan error, 1)
+			go func() { written <- req.Write(clientConn) }()
+			resp, err := http.ReadResponse(bufio.NewReader(clientConn), req)
+			if err != nil {
+				t.Fatal(err)
+			}
+			defer resp.Body.Close()
+			got, err := io.ReadAll(resp.Body)
+			if err != nil || resp.StatusCode != 200 || string(got) != "ok" {
+				t.Fatalf("upload hit default read deadline: status=%d body=%q error=%v", resp.StatusCode, got, err)
+			}
+			if err := <-written; err != nil {
+				t.Fatal(err)
+			}
+			if got := <-upstreamBody; !bytes.Equal(got, body) {
+				t.Fatalf("streamed body changed: received %d bytes", len(got))
+			}
+		})
+	}
+}
+
+type uninspectedHeadroomAdapter struct{ providers.Adapter }
+
+func (a uninspectedHeadroomAdapter) InspectRequest(context.Context, providers.BodyReader, http.Header) (providers.RequestMetadata, error) {
+	return providers.RequestMetadata{}, errors.New("streaming request must never be inspected")
+}
+
+func (a uninspectedHeadroomAdapter) ApplyProviderNativeTransforms(context.Context, providers.BodyReader, providers.RequestMetadata, providers.TransformPolicy) (providers.TransformResult, error) {
+	return providers.TransformResult{}, errors.New("streaming request must never be transformed")
+}
+
+type headroomReadProbe struct {
+	reader io.Reader
+	read   int
+}
+
+func (p *headroomReadProbe) Read(b []byte) (int, error) {
+	n, err := p.reader.Read(b)
+	p.read += n
+	return n, err
+}
+
+func headroomStreamServer(t *testing.T, mode string, sink TelemetrySink, transport http.RoundTripper) *Server {
+	t.Helper()
+	adapter, err := openaicompat.NewNamed("headroom", "https://headroom.test/base?configured=1", "ChatGPT-Account-ID")
+	if err != nil {
+		t.Fatal(err)
+	}
+	return New(Config{
+		Adapters: []providers.Adapter{uninspectedHeadroomAdapter{adapter}},
+		Auth:     stubAuth{rc: RequestContext{Label: "test", RuntimeMode: mode}},
+		Creds:    stubCreds{key: "test-key"}, Sink: sink,
+		HTTPClient: &http.Client{Transport: transport},
+	})
+}
+
+func TestHeadroomLargeUploadStreamsBeforeEOF(t *testing.T) {
+	t.Setenv("CAVE_MAX_TRANSFORM_BYTES", "32")
+	t.Setenv("CAVE_MAX_REQUEST_BYTES", "")
+	body := bytes.Repeat([]byte{0, 255, 128, 'm'}, 50)
+	for _, mode := range []string{"compress", "pixel", "cache", "record"} {
+		for _, known := range []bool{true, false} {
+			t.Run(mode+"/known="+strconv.FormatBool(known), func(t *testing.T) {
+				probe := &headroomReadProbe{reader: bytes.NewReader(body)}
+				sink, calls := &captureSink{}, 0
+				srv := headroomStreamServer(t, mode, sink, roundTripFunc(func(r *http.Request) (*http.Response, error) {
+					calls++
+					wantRead := 33
+					wantLength := int64(-1)
+					if known {
+						wantRead, wantLength = 0, int64(len(body))
+					}
+					if probe.read != wantRead || r.ContentLength != wantLength {
+						t.Errorf("before send: consumed=%d want=%d length=%d want=%d", probe.read, wantRead, r.ContentLength, wantLength)
+					}
+					got, err := io.ReadAll(r.Body)
+					if err != nil || !bytes.Equal(got, body) {
+						t.Errorf("stream changed media bytes: len=%d error=%v", len(got), err)
+					}
+					if r.URL.String() != "https://headroom.test/base/v1/responses?configured=1&request=2" ||
+						r.Header.Get("Authorization") != "Bearer test-key" || r.Header.Get("ChatGPT-Account-ID") != "account" ||
+						r.Header.Get("Content-Encoding") != "gzip" || r.Header.Get("X-Headroom-Bypass") != "true" ||
+						r.Header.Get("X-Cave-Private") != "" {
+						t.Errorf("route/header contract changed: URL=%s headers=%v", r.URL, r.Header)
+					}
+					return &http.Response{StatusCode: 200, Header: http.Header{"Content-Type": {"text/event-stream"}}, Body: io.NopCloser(strings.NewReader("data: done\n\n"))}, nil
+				}))
+				req := httptest.NewRequest(http.MethodPost, "/compat/headroom/v1/responses?request=2", probe)
+				req.ContentLength = -1
+				if known {
+					req.ContentLength = int64(len(body))
+				}
+				req.Header.Set("Content-Encoding", "gzip")
+				req.Header.Set("ChatGPT-Account-ID", "account")
+				req.Header.Set("X-Cave-Private", "private")
+				rec := httptest.NewRecorder()
+				srv.Handler().ServeHTTP(rec, req)
+				if rec.Code != 200 || calls != 1 || rec.Body.String() != "data: done\n\n" || rec.Header().Get("X-Cave-Bypass") != "request_size" {
+					t.Fatalf("status=%d calls=%d body=%q bypass=%q", rec.Code, calls, rec.Body.String(), rec.Header().Get("X-Cave-Bypass"))
+				}
+				row := sink.last(t)
+				hash := sha256.Sum256(body)
+				if row.RequestBytes != len(body) || !row.RequestHashComplete || row.RawRequestSHA256 != hex.EncodeToString(hash[:]) || row.RawRequestSHA256 != row.TransformedRequestSHA256 ||
+					len(row.OptimizationIDs) != 0 || row.CompressionEligible || row.TotalCostUSD != 0 || row.Model != "unknown" {
+					t.Fatalf("dishonest streamed telemetry: %+v", row)
+				}
+			})
+		}
+	}
+}
+
+func TestHeadroomExplicitUploadCap(t *testing.T) {
+	t.Setenv("CAVE_MAX_TRANSFORM_BYTES", "32")
+	t.Setenv("CAVE_MAX_REQUEST_BYTES", "64")
+	for _, known := range []bool{true, false} {
+		t.Run(strconv.FormatBool(known), func(t *testing.T) {
+			probe := &headroomReadProbe{reader: strings.NewReader(strings.Repeat("x", 65))}
+			calls, received := 0, 0
+			sink := &captureSink{}
+			srv := headroomStreamServer(t, "compress", sink, roundTripFunc(func(r *http.Request) (*http.Response, error) {
+				calls++
+				body, err := io.ReadAll(r.Body)
+				received = len(body)
+				if err == nil {
+					t.Error("over-limit upload must fail its reader")
+				}
+				return nil, err
+			}))
+			req := httptest.NewRequest(http.MethodPost, "/compat/headroom/v1/responses", probe)
+			req.ContentLength = -1
+			if known {
+				req.ContentLength = 65
+			}
+			rec := httptest.NewRecorder()
+			srv.Handler().ServeHTTP(rec, req)
+			if rec.Code != 413 || calls > 1 || received > 64 {
+				t.Fatalf("cap status=%d calls=%d received=%d", rec.Code, calls, received)
+			}
+			if known && (calls != 0 || probe.read != 0) {
+				t.Fatalf("known oversized upload was read/sent: reads=%d calls=%d", probe.read, calls)
+			}
+			if !known {
+				row := sink.last(t)
+				if calls != 1 || row.RequestHashComplete || row.RawRequestSHA256 != "" || row.RequestBytes != 64 {
+					t.Fatalf("cap must not replay or claim complete body: calls=%d row=%+v", calls, row)
+				}
+			}
+		})
+	}
+}
+
+func TestHeadroomStreamFailureDoesNotReplay(t *testing.T) {
+	t.Setenv("CAVE_MAX_TRANSFORM_BYTES", "4")
+	t.Setenv("CAVE_MAX_REQUEST_BYTES", "")
+	for _, cancel := range []bool{false, true} {
+		t.Run(strconv.FormatBool(cancel), func(t *testing.T) {
+			ctx, stop := context.WithCancel(context.Background())
+			defer stop()
+			calls, sink := 0, &captureSink{}
+			srv := headroomStreamServer(t, "compress", sink, roundTripFunc(func(r *http.Request) (*http.Response, error) {
+				calls++
+				if _, err := io.CopyN(io.Discard, r.Body, 2); err != nil {
+					t.Fatal(err)
+				}
+				if cancel {
+					stop()
+					if r.Context().Err() != context.Canceled {
+						t.Error("upstream lost caller cancellation")
+					}
+					return nil, r.Context().Err()
+				}
+				return nil, &net.OpError{Op: "dial", Err: errors.New("connection failed")}
+			}))
+			req := httptest.NewRequest(http.MethodPost, "/compat/headroom/v1/responses", strings.NewReader("large media body")).WithContext(ctx)
+			rec := httptest.NewRecorder()
+			srv.Handler().ServeHTTP(rec, req)
+			row := sink.last(t)
+			if calls != 1 || rec.Code != 502 || row.RequestBytes != 2 || row.RequestHashComplete || row.RawRequestSHA256 != "" || row.TransformedRequestSHA256 != "" {
+				t.Fatalf("failed stream replayed/claimed exact body: calls=%d status=%d row=%+v", calls, rec.Code, row)
+			}
+		})
+	}
+}
