diff --git a/proxy/internal/gateway/request_size_test.go b/proxy/internal/gateway/request_size_test.go
new file mode 100644
index 0000000..3fe07fc
--- /dev/null
+++ b/proxy/internal/gateway/request_size_test.go
@@ -0,0 +1,167 @@
+package gateway
+
+import (
+	"bytes"
+	"context"
+	"io"
+	"net/http"
+	"net/http/httptest"
+	"strconv"
+	"strings"
+	"testing"
+
+	"github.com/JuliusBrussee/caveman/proxy/providers"
+	"github.com/JuliusBrussee/caveman/proxy/providers/openai"
+)
+
+type requestSizeNativeAdapter struct {
+	providers.Adapter
+	calls *int
+}
+
+func (a requestSizeNativeAdapter) ApplyProviderNativeTransforms(context.Context, providers.BodyReader, providers.RequestMetadata, providers.TransformPolicy) (providers.TransformResult, error) {
+	*a.calls++
+	return providers.TransformResult{Body: []byte(`{"model":"gpt-5.6","input":"transformed"}`), OptimizerIDs: []string{"native.test"}}, nil
+}
+
+func TestRequestSizeBypassSkipsEveryTransformPath(t *testing.T) {
+	body := openAIPixelBody()
+	for _, mode := range []string{"compress", "pixel", "cache", "record"} {
+		for _, unknownLength := range []bool{false, true} {
+			t.Run(mode+"/unknown_length="+strconv.FormatBool(unknownLength), func(t *testing.T) {
+				t.Setenv("CAVE_MAX_TRANSFORM_BYTES", "128")
+				t.Setenv("CAVE_MAX_REQUEST_BYTES", strconv.Itoa(len(body)+1))
+				comp := &estimateStub{before: 100, after: 1}
+				nativeCalls, upstreamCalls := 0, 0
+				var adapter providers.Adapter = openai.New("https://upstream.test")
+				if mode == "cache" {
+					adapter = requestSizeNativeAdapter{Adapter: adapter, calls: &nativeCalls}
+				}
+				sink := &captureSink{}
+				srv := New(Config{
+					Adapters: []providers.Adapter{adapter},
+					Auth:     stubAuth{rc: RequestContext{Label: "local", RuntimeMode: mode}},
+					Creds:    stubCreds{key: "sk-byok"}, Sink: sink, Compressor: comp,
+					ObserveEstimate: true, RecoveryViaMCP: true,
+					HTTPClient: &http.Client{Transport: roundTripFunc(func(r *http.Request) (*http.Response, error) {
+						upstreamCalls++
+						got, err := io.ReadAll(r.Body)
+						if err != nil || !bytes.Equal(got, body) {
+							t.Errorf("size bypass changed original bytes: read error=%v", err)
+						}
+						if r.URL.Path != "/v1/chat/completions" || r.Header.Get("Authorization") != "Bearer sk-byok" {
+							t.Errorf("size bypass changed common routing/credentials: path=%q auth=%q", r.URL.Path, r.Header.Get("Authorization"))
+						}
+						return &http.Response{StatusCode: http.StatusOK, Header: make(http.Header), Body: io.NopCloser(strings.NewReader(openAIPixelResponse()))}, nil
+					})},
+				})
+				request := httptest.NewRequest(http.MethodPost, "/v1/chat/completions", bytes.NewReader(body))
+				if unknownLength {
+					request.ContentLength = -1
+				}
+				recorder := httptest.NewRecorder()
+				srv.Handler().ServeHTTP(recorder, request)
+				if recorder.Code != http.StatusOK || recorder.Header().Get("x-cave-bypass") != "request_size" {
+					t.Fatalf("status=%d bypass=%q, want 200/request_size", recorder.Code, recorder.Header().Get("x-cave-bypass"))
+				}
+				if upstreamCalls != 1 || comp.compressCalls != 0 || comp.estimateCalls != 0 || comp.storeCalls != 0 || nativeCalls != 0 {
+					t.Errorf("bypass ran transforms: upstream=%d compression=%d estimate=%d store=%d native=%d", upstreamCalls, comp.compressCalls, comp.estimateCalls, comp.storeCalls, nativeCalls)
+				}
+				row := sink.last(t)
+				if row.RawRequestSHA256 != row.TransformedRequestSHA256 || len(row.OptimizationIDs) != 0 || row.RecoveryHandle != "" {
+					t.Errorf("bypass claimed transformed bytes or recovery: %+v", row)
+				}
+			})
+		}
+	}
+}
+
+func TestRequestSizeBypassBoundariesAndNextRequest(t *testing.T) {
+	t.Setenv("CAVE_MAX_TRANSFORM_BYTES", "128")
+	t.Setenv("CAVE_MAX_REQUEST_BYTES", "200")
+	nativeCalls, upstreamCalls := 0, 0
+	var forwarded []byte
+	srv := New(Config{
+		Adapters: []providers.Adapter{requestSizeNativeAdapter{Adapter: openai.New("https://upstream.test"), calls: &nativeCalls}},
+		Auth:     stubAuth{rc: RequestContext{RuntimeMode: "cache"}}, Creds: stubCreds{key: "sk-test"},
+		HTTPClient: &http.Client{Transport: roundTripFunc(func(r *http.Request) (*http.Response, error) {
+			upstreamCalls++
+			forwarded, _ = io.ReadAll(r.Body)
+			return &http.Response{StatusCode: 200, Header: make(http.Header), Body: io.NopCloser(strings.NewReader(`{}`))}, nil
+		})},
+	})
+	for _, tc := range []struct {
+		size, status int
+		bypass       bool
+	}{
+		{128, 200, false}, {129, 200, true}, {128, 200, false}, {200, 200, true}, {201, 413, false},
+	} {
+		body := `{"model":"gpt-5.6","input":"original"}`
+		body += strings.Repeat(" ", tc.size-len(body))
+		rec := httptest.NewRecorder()
+		req := httptest.NewRequest(http.MethodPost, "/v1/responses", strings.NewReader(body))
+		req.ContentLength = -1 // Enforce limits using bytes read, including chunked uploads.
+		srv.Handler().ServeHTTP(rec, req)
+		if rec.Code != tc.status || (rec.Header().Get("x-cave-bypass") == "request_size") != tc.bypass {
+			t.Fatalf("size=%d: status=%d bypass=%q", tc.size, rec.Code, rec.Header().Get("x-cave-bypass"))
+		}
+		if tc.bypass && string(forwarded) != body {
+			t.Fatalf("size=%d: bypass changed payload", tc.size)
+		}
+	}
+	if upstreamCalls != 4 || nativeCalls != 2 {
+		t.Fatalf("upstream=%d native=%d: hard rejection must not forward, and next small request must optimize", upstreamCalls, nativeCalls)
+	}
+}
+
+func TestRequestSizeBypassPreservesUpstreamResponseWithoutReplay(t *testing.T) {
+	t.Setenv("CAVE_MAX_TRANSFORM_BYTES", "1")
+	for _, tc := range []struct {
+		status                int
+		contentType, response string
+	}{
+		{200, "text/event-stream", "data: {\"type\":\"response.completed\"}\n\n"},
+		{413, "application/json", `{"error":"upstream limit"}`},
+	} {
+		calls := 0
+		srv := New(Config{
+			Adapters: []providers.Adapter{openai.New("https://upstream.test")},
+			Auth:     stubAuth{rc: RequestContext{RuntimeMode: "compress"}}, Creds: stubCreds{},
+			HTTPClient: &http.Client{Transport: roundTripFunc(func(r *http.Request) (*http.Response, error) {
+				calls++
+				return &http.Response{StatusCode: tc.status, Header: http.Header{"Content-Type": {tc.contentType}}, Body: io.NopCloser(strings.NewReader(tc.response))}, nil
+			})},
+		})
+		rec := httptest.NewRecorder()
+		srv.Handler().ServeHTTP(rec, httptest.NewRequest(http.MethodPost, "/v1/responses", strings.NewReader(`{"model":"gpt-5.6","input":"hello"}`)))
+		if calls != 1 || rec.Code != tc.status || rec.Body.String() != tc.response {
+			t.Fatalf("upstream response changed/replayed: calls=%d status=%d body=%q", calls, rec.Code, rec.Body.String())
+		}
+	}
+}
+
+func TestRequestSizeInvalidLimitsKeepFiniteDefaults(t *testing.T) {
+	for _, value := range []string{"", "0", "-1", "invalid", "9223372036854775807"} {
+		t.Run(value, func(t *testing.T) {
+			t.Setenv("CAVE_MAX_REQUEST_BYTES", value)
+			t.Setenv("CAVE_MAX_TRANSFORM_BYTES", value)
+			const body = `{"model":"gpt-5.6","input":"hello"}`
+			srv := New(Config{
+				Adapters: []providers.Adapter{openai.New("https://upstream.test")},
+				Auth:     stubAuth{rc: RequestContext{RuntimeMode: "record"}}, Creds: stubCreds{},
+				HTTPClient: &http.Client{Transport: roundTripFunc(func(r *http.Request) (*http.Response, error) {
+					got, _ := io.ReadAll(r.Body)
+					if string(got) != body {
+						t.Errorf("invalid limit truncated request: %q", got)
+					}
+					return &http.Response{StatusCode: 200, Header: make(http.Header), Body: io.NopCloser(strings.NewReader(`{}`))}, nil
+				})},
+			})
+			rec := httptest.NewRecorder()
+			srv.Handler().ServeHTTP(rec, httptest.NewRequest(http.MethodPost, "/v1/responses", strings.NewReader(body)))
+			if rec.Code != 200 || rec.Header().Get("x-cave-bypass") != "" {
+				t.Fatalf("invalid limit rejected/bypassed small request: status=%d", rec.Code)
+			}
+		})
+	}
+}
