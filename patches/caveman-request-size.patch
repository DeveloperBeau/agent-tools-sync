diff --git a/proxy/internal/nativehook/hook_codex_output_test.go b/proxy/internal/nativehook/hook_codex_output_test.go
new file mode 100644
index 0000000..d140b1f
--- /dev/null
+++ b/proxy/internal/nativehook/hook_codex_output_test.go
@@ -0,0 +1,97 @@
+package nativehook
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"testing"
+)
+
+func TestDelegatedCodexPostCompactOutput(t *testing.T) {
+	node, err := exec.LookPath("node")
+	if err != nil {
+		t.Skip("Node adapter runtime unavailable")
+	}
+	t.Setenv("NODE", node)
+	home := t.TempDir()
+	adapter := filepath.Join(home, "adapter.cjs")
+	input := filepath.Join(home, "input.json")
+	t.Setenv("CAVE_TEST_INPUT", input)
+	if err := os.WriteFile(adapter, []byte(`
+const fs = require("node:fs");
+let raw = "";
+process.stdin.on("data", chunk => { raw += chunk; });
+process.stdin.on("end", () => {
+  fs.writeFileSync(process.env.CAVE_TEST_INPUT, raw);
+  process.stdout.write(process.env.CAVE_TEST_OUTPUT);
+  process.stderr.write("adapter diagnostic\n");
+});
+`), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	contextOutput := `{"hookSpecificOutput":{"hookEventName":"PostCompact","additionalContext":"restore core"}}`
+	for _, tc := range []struct {
+		name, agent, event, output string
+		strip                      bool
+	}{
+		{"codex context only", "codex", "PostCompact", contextOutput, true},
+		{"codex controls and context", "codex", "PostCompact", `{"continue":false,"stopReason":"operator stop","systemMessage":"warning","suppressOutput":true,"hookSpecificOutput":{"hookEventName":"PostCompact","additionalContext":"restore core"}}`, true},
+		{"codex valid controls", "codex", "PostCompact", `{"continue":false,"stopReason":"operator stop"}`, false},
+		{"codex compact session start", "codex", "SessionStart", `{"hookSpecificOutput":{"hookEventName":"SessionStart","additionalContext":"restore core"}}`, false},
+		{"claude context unchanged", "claude", "PostCompact", contextOutput, false},
+		{"codex other event unchanged", "codex", "UserPromptSubmit", contextOutput, false},
+		{"malformed output remains visible", "codex", "PostCompact", `{"hookSpecificOutput":`, false},
+		{"empty output unchanged", "codex", "PostCompact", "", false},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			t.Setenv("CAVE_TEST_OUTPUT", tc.output)
+			raw, err := json.Marshal(map[string]string{"hook_event_name": tc.event, "session_id": "compact-test", "source": "compact"})
+			if err != nil {
+				t.Fatal(err)
+			}
+			var stdout, stderr bytes.Buffer
+			if err := Run(context.Background(), home, tc.agent, adapter, raw, &stdout, &stderr); err != nil {
+				t.Fatal(err)
+			}
+			recorded, err := os.ReadFile(input)
+			if err != nil || !bytes.Equal(recorded, raw) {
+				t.Fatalf("lifecycle input changed: %q (%v)", recorded, err)
+			}
+			if stderr.String() != "adapter diagnostic\n" {
+				t.Fatalf("adapter diagnostic lost: %q", stderr.String())
+			}
+			if !tc.strip {
+				if stdout.String() != tc.output {
+					t.Fatalf("unrelated output changed: %q", stdout.String())
+				}
+				return
+			}
+			var expected map[string]json.RawMessage
+			if err := json.Unmarshal([]byte(tc.output), &expected); err != nil {
+				t.Fatal(err)
+			}
+			delete(expected, "hookSpecificOutput")
+			if len(expected) == 0 {
+				if stdout.Len() != 0 {
+					t.Fatalf("unsupported context reached Codex: %q", stdout.String())
+				}
+				return
+			}
+			var actual map[string]json.RawMessage
+			if err := json.Unmarshal(stdout.Bytes(), &actual); err != nil {
+				t.Fatal(err)
+			}
+			if len(actual) != len(expected) {
+				t.Fatalf("unexpected output fields: %s", stdout.Bytes())
+			}
+			for key, value := range expected {
+				if !bytes.Equal(actual[key], value) {
+					t.Fatalf("common field %s changed: %s", key, stdout.Bytes())
+				}
+			}
+		})
+	}
+}
